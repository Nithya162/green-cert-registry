# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must NEVER be committed.

# RPC endpoint for Sepolia (e.g. from Alchemy or Infura)
SEPOLIA_RPC_URL=

# Private key of the TEST wallet used to deploy (never use a real wallet)
DEPLOYER_PRIVATE_KEY=

# Private key of the Data Checker (oracle) test account
CHECKER_PRIVATE_KEY=

# Deployed contract addresses (filled in after deployment)
ROLE_REGISTRY_ADDRESS=
CERTIFICATE_REGISTRY_ADDRESS=
